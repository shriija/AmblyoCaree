# MongoDB connection URI (optional in local preview; falls back to persistent local document store when omitted)
MONGODB_URI="mongodb://localhost:27017/amblyocare"

# JWT secret for signing HTTP-only authentication cookies
JWT_SECRET="replace-with-a-strong-random-secret"

# JWT token expiration duration
JWT_EXPIRES_IN="7d"

# Server port (defaults to 3000)
PORT="3000"

# Application URL
APP_URL="http://localhost:3000"
